<!DOCTYPE html>
<html {{ site.language_attributes }}>
	<head>
		{% block html_head %}
			<meta charset="{{ site.charset }}" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			<meta name="theme-color" content="#2D2E31" />

			<!-- Prefetch and Preconnect -->
			<link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
			<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
			<link rel="preconnect" href="https://connect.facebook.net" crossorigin />

			<link rel="preconnect" href="https://fonts.googleapis.com" />
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

			<link
				rel="preload"
				href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400;1,500&family=Sora:wght@300;400;500;600;700&display=swap"
				as="style"
			/>
			<link
				href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400;1,500&family=Sora:wght@300;400;500;600;700&display=swap"
				rel="stylesheet"
			/>

			<link rel="dns-prefetch" href="https://www.google-analytics.com" />
			<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
			<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
			<link rel="dns-prefetch" href="https://connect.facebook.net" />

			{{ function("wp_head") }}
			{% block head %}

			{% endblock %}
		{% endblock %}
	</head>

	<body class="{{ body_class }} bg-body font-sans text-white antialiased" x-data="{ isMenuOpen: false, isSearchOpen: false }">
		{% block header %}
			{% include "global/header.twig" %}
		{% endblock %}
		{% block offcanvas %}
			{% include "global/offcanvas.twig" %}
		{% endblock %}
		{% block content %}
			Sorry, no content
		{% endblock %}
		{% block footer %}
			{% include "global/footer.twig" %}
		{% endblock %}
		{% block play_for_free_panel %}
			{% include "global/play-for-free-panel.twig" %}
		{% endblock %}
		{% block scroll_progress %}
			{% include "global/scroll-progress.twig" %}
		{% endblock %}
		{% include "global/svg-sprite.twig" %}
		{{ function("wp_footer") }}
	</body>
</html>
