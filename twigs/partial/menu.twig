{% if items %}
	<ul class="{{ class }}">
		{% for item in items %}
			<li class="group relative {{ item.current ? 'active' }}">
				<a class="block px-4 py-2 transition-colors {{ item.current ? 'active' : '' }}"
					 href="{{ item.link }}"
					 {% if item.target %}target="{{ item.target }}"{% endif %}
					{% if offcanvas is defined %}@click="isMenuOpen = false"{% endif %}>
					{{ item.title }}
				</a>
				{% if item.children %}
					<div class="absolute left-0 mt-1 w-56 origin-top-left bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-10">
						{% include "partial/menu.twig" with {'items': item.children, 'class': 'py-1'} %}
					</div>
				{% endif %}
			</li>
		{% endfor %}
	</ul>
{% endif %}
