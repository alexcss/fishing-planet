{% from "components/icon.twig" import icon %}

{% if global.socials %}
	{% if vertical is defined and vertical %}
		{# Vertical layout for footer #}
		<div class="flex flex-col gap-16">
			{% for social in global.socials %}
				<a href="{{ social.url }}" class="fp-link flex items-center gap-8" target="_blank" rel="noopener noreferrer">
					{{ icon({ name: social.icon, w: 20, h: 20, class: "-mt-2" }) }}
					<span class="fp-text-link">{{ social.icon }}</span>
				</a>
			{% endfor %}
		</div>
	{% else %}
		{# Horizontal layout #}
		<div class="flex items-center gap-4">
			{% if global.socials_title %}
				<span class="text-sm text-gray-400">{{ global.socials_title }}</span>
			{% endif %}
			<div class="flex gap-3">
				{% for social in global.socials %}
					<a
						href="{{ social.url }}"
						class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-800 text-gray-300 transition-colors hover:bg-gray-700 hover:text-white"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="{{ social.icon }}"
					>
						{{ icon({ name: social.icon, w: 20, h: 20 }) }}
					</a>
				{% endfor %}
			</div>
		</div>
	{% endif %}
{% endif %}
