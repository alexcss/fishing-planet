{% if items %}
	<ul class="{{ class }}">
		{% for item in items %}
			<li>
				<a class="inline-block text-gray-300 hover:text-white transition-colors"
					 href="{{ item.link }}"
					 {% if item.target %}target="{{ item.target }}"{% endif %}
					{% if offcanvas is defined %}@click="isMenuOpen = false"{% endif %}>
					{{ item.title }}
				</a>
			</li>
		{% endfor %}
	</ul>
{% endif %}
