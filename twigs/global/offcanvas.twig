{% from "components/buttons.twig" import button %}
<!-- Mobile Menu -->
<div
	x-cloak
	x-show="isMenuOpen"
	@click.away="isMenuOpen = false"
	class="fp-wp-top fixed inset-0 z-40 lg:hidden"
	x-transition:enter="transition ease-in-out duration-300 transform"
	x-transition:enter-start="-translate-x-full"
	x-transition:enter-end="translate-x-0"
	x-transition:leave="transition ease-in-out duration-300 transform"
	x-transition:leave-start="translate-x-0"
	x-transition:leave-end="-translate-x-full"
>
	<div class="bg-black-cat bg-pattern-wave absolute inset-y-0 left-0 z-0 w-full overflow-y-auto pt-145 pb-184 text-white">
		<div class="container">
			<nav>
				{% include "partial/menu-mobile.twig" with { items: menu.desktop_nav.get_items, class: "space-y-32", offcanvas: true } %}
			</nav>
		</div>
		<button @click="isMenuOpen = false" class="absolute top-4 right-4 text-gray-500 hover:text-gray-700">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
	</div>
	<div class="from-gray-tar/60 absolute inset-x-0 bottom-0 z-10 bg-linear-to-t to-transparent">
		<div class="container py-32" x-data="{ isStoresOpen: false }" @click.outside="isStoresOpen = false">
			<div class="relative pb-24">
				<div class="transition duration-200 ease-in-out" :class="{'-translate-y-full opacity-0': isStoresOpen}">
					{% include "global/socials-buttons.twig" %}
				</div>
				<div class="absolute inset-x-0 top-full pb-24 transition duration-200 ease-in-out" :class="{'-translate-y-full': isStoresOpen}">
					{% include "global/stores-links.twig" %}
				</div>
			</div>
			{{ button({ link: header.button, icon: "spinning", class: "w-full relative z-10", props: '@click.prevent="isStoresOpen = !isStoresOpen"' }) }}
		</div>
	</div>
</div>
