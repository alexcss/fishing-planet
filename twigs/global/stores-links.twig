{% from "components/icon.twig" import icon %}

{% if (items|length) > 0 %}
	<div class="flex w-fit flex-wrap gap-4 md:gap-10">
		{% for store in items %}
			<a
				href="{{ store.url }}"
				class="hover:bg-accent flex size-40 items-center justify-center bg-white hover:text-black {{
				variant == "dark"
					? "text-black"
					: "text-gray-stone"
				}}"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="{{ store.icon }}"
			>
				{{ icon({ name: store.icon, w: 26, h: 26 }) }}
			</a>
		{% endfor %}
	</div>
{% endif %}
