{#
 # DLC Single - CTA Section
 # "Get this pack" call to action with stores dropdown
 #}

{% from "components/icon.twig" import icon %}

{% if stores %}
	<section class="py-60 xl:py-120">
		<div class="relative">
			<div class="relative z-10 container py-18 md:py-0">
				<div class="fp-block-corners mx-auto max-w-980 px-20 py-52 text-center md:py-88">
					<div class="space-y-32 md:space-y-40">
						<h2 class="h2">{{ __("Get this pack and start fishing immediately", "fp") }}</h2>

						<div class="relative inline-block" x-data="{ open: false }" @click.outside="open = false">
							<button class="fp-btn" @click.prevent="open = !open">{{ __("Get the pack", "fp") }}</button>

							<div
								class="bg-gray-tar absolute top-full left-1/2 z-20 mt-16 w-166 -translate-x-1/2 border border-white/15 p-18 md:w-180"
								x-show="open"
								x-transition:enter="transition ease-out duration-200"
								x-transition:enter-start="opacity-0 -translate-y-8"
								x-transition:enter-end="opacity-100 translate-y-0"
								x-transition:leave="transition ease-in duration-150"
								x-transition:leave-start="opacity-100 translate-y-0"
								x-transition:leave-end="opacity-0 -translate-y-8"
								@click.outside="open = false"
								x-cloak
							>
								{% include "global/stores-links.twig" with { items: stores } %}
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="bg-pattern-wave pointer-events-none absolute inset-0 mask-y-from-60% mask-y-to-100% opacity-60"></div>
		</div>
	</section>
{% endif %}
