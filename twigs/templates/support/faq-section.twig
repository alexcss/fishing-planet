{% from "components/icon.twig" import icon %}

{% if data and data.items is not empty %}
	<section class="py-60 xl:pt-140 xl:pb-120">
		<div class="container">
			{% if data.title %}
				<h2 class="h2 mb-40 md:mb-56">{{ data.title }}</h2>
			{% endif %}

			<div class="divide-y divide-white/15 border-y border-white/15" x-data="{ active: null }">
				{% for item in data.items %}
					<div x-data="{ id: {{ loop.index }} }">
						<button
							class="group/btn flex w-full items-center justify-between gap-24 py-24 text-left"
							@click="active = (active === id) ? null : id"
							:aria-expanded="active === id"
						>
							<span class="fp-captital-title flex items-start gap-14 md:gap-20">
								<span class="fp-text-small-description text-sand min-w-24 shrink-0 pt-2">{{ "%02d"|format(loop.index) }}</span>
								{{ item.title }}
							</span>
							<span class="fp-btn-corners flex-shrink-0 transition">
								<span>
									<span x-cloak :class="active === id ? 'hidden' : ''">{{ icon({ name: "plus", w: 24, h: 24 }) }}</span>
									<span x-cloak :class="active !== id ? 'hidden' : ''">{{ icon({ name: "minus", w: 15, h: 15 }) }}</span>
								</span>
							</span>
						</button>

						<div class="fp-collapse" :class="active === id ? 'open' : ''">
							<div class="overflow-hidden">
								<div class="fp-richtext fp-text-body-article pb-32 text-white md:max-w-1000 md:pl-40 xl:pt-8 xl:pb-40">
									{{ item.text|raw }}
								</div>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</section>
{% endif %}
