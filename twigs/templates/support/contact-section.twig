{% from "components/image.twig" import image %}

{% if data %}
	<section class="relative pt-32 pb-54 md:py-60 xl:py-100">
		<div class="relative z-10 container">
			<div class="grid grid-cols-1 items-start gap-32 lg:grid-cols-2 xl:gap-60">
				<div class="bg-gray-gunmetal px-20 py-40 md:px-32 xl:px-60 xl:py-50">
					{% if data.title %}
						<h2 class="h3 mb-32">{{ data.title }}</h2>
					{% endif %}

					{% if data.cf7_shortcode %}
						<div class="fp-cf7">
							{{ fn("do_shortcode", data.cf7_shortcode) }}
						</div>
					{% endif %}
				</div>

				{% if data.image %}
					<div class="md:fp-block-corners">
						{{ image({ image: data.image, class: "w-full", sizes: { w: 608, h: 562 } }) }}
					</div>
				{% endif %}
			</div>
		</div>
		<div class="bg-pattern-wave pointer-events-none absolute inset-0 mask-y-from-60% mask-y-to-100% opacity-60"></div>
	</section>
{% endif %}
