<section class="relative pt-40 md:pt-60 xl:pt-100">
	<div class="relative z-10 container">
		<div class="flex flex-col gap-24 md:items-start lg:flex-row">
			{% if data.title %}
				<div class="flex flex-col items-start gap-24 md:flex-row">
					{% if data.subtitle %}
						<p class="fp-text-small-description text-sand mt-2 md:order-1 md:max-w-120 md:pt-2 xl:pt-4">
							{{ data.subtitle }}
						</p>
					{% endif %}
					<h1 class="h1">{{ data.title }}</h1>
				</div>
			{% endif %}

			{% if data.tagline %}
				<div class="fp-block-corners w-full text-white md:ml-auto lg:max-w-300">
					<p class="h5 text-center">
						{{ data.tagline }}
					</p>
				</div>
			{% endif %}
		</div>
	</div>
</section>
