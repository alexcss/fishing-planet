{#
 # Single Post - Hero Section
 # Back button, title, excerpt, category + date + reading time
 #}

<section class="relative pt-40 pb-40 md:pt-60 md:pb-60">
	<div class="relative z-10 container">
		<div class="relative">
			{% include "components/back-button.twig" with { class: "mb-40 lg:absolute lg:left-0 lg:top-6" } %}

			<div class="lg:mx-auto lg:max-w-640 xl:max-w-756">
				<h1 class="h2 mb-24 md:mb-32">{{ post.title }}</h1>

				{% if post.post_excerpt %}
					<p class="fp-text-body-article mb-32 text-white/80 md:mb-40">
						{{ post.post_excerpt }}
					</p>
				{% endif %}

				<div class="flex flex-wrap items-center gap-x-24 gap-y-12 xl:gap-x-32">
					{% if post.categories %}
						<div class="flex flex-wrap items-center gap-12">
							{% for cat in post.categories %}
								<span class="fp-badge">{{ cat.name }}</span>
							{% endfor %}
						</div>
					{% endif %}

					<time class="fp-text-caption text-white/70" datetime="{{ post.date("Y-m-d") }}">{{ post.date("d.m.Y") }}</time>

					{% set reading_time = post.reading_time %}
					{% if reading_time %}
						<span class="fp-text-caption flex h-20 items-center border-r border-l border-white/15 px-24 text-white/70 uppercase xl:px-32">
							{{ reading_time }}
						</span>
					{% endif %}
				</div>
			</div>
		</div>
	</div>

	<div class="bg-pattern-wave absolute inset-x-0 top-0 z-0 h-730 mask-y-from-80% mask-y-to-100% lg:h-428"></div>
</section>
