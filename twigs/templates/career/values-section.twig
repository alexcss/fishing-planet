{#
# Career Values Section
# Interactive letter word with scrollable content panel
#}

{% from "components/icon.twig" import icon %}

{% if data and data.items %}
	<section x-data="careerValues({{ data.items|length }})" class="relative py-60 md:py-80 xl:py-100">
		<div class="container xl:pt-32">
			{% if data.title %}
				<h2 class="h2 mb-32 text-left md:mb-40 md:text-center xl:mb-56">{{ data.title }}</h2>
			{% endif %}

			<div
				x-ref="letters"
				class="no-scrollbar -mx-16 mb-20 flex gap-12 overflow-y-hidden px-16 pb-20 max-lg:overflow-x-auto md:-mx-32 md:mb-40 md:gap-24 md:px-32 lg:mx-0 lg:justify-between lg:px-0"
			>
				{% for item in data.items %}
					<button
						type="button"
						class="fp-btn-corners fp-btn-corners-lg fp-btn-corners-transparent font-heading text-70/none xl:text-80 size-125 lg:h-auto lg:w-full lg:max-w-144"
						:class="{ 'active': active === {{ loop.index0 }} }"
						@click="active = {{ loop.index0 }}"
						aria-label="{{ item.title }}"
					>
						<span>{{ item.letter }}</span>
					</button>
				{% endfor %}
			</div>

			<div class="mb-40 flex items-center justify-between gap-12 md:mb-40 lg:hidden">
				<button type="button" class="fp-btn-sqr" @click="prev()" aria-label="{{ __("Previous value", "fp") }}">
					{{ icon({ name: "arrow-l", w: 24, h: 24 }) }}
				</button>
				<div class="fp-captital-title flex items-center justify-center gap-0">
					{% for item in data.items %}
						<span :class="{ 'text-accent': active === {{ loop.index0 }} }">{{ item.letter }}</span>
					{% endfor %}
				</div>
				<button type="button" class="fp-btn-sqr" @click="next()" aria-label="{{ __("Next value", "fp") }}">
					{{ icon({ name: "arrow-r", w: 24, h: 24 }) }}
				</button>
			</div>

			<div class="relative h-450 lg:h-375">
				{% for item in data.items %}
					<div
						x-show="active === {{ loop.index0 }}"
						x-transition.opacity.duration.300ms
						{{ not loop.first ? "x-cloak" }}
						class="fp-scrollbar-thin absolute inset-0 overflow-y-auto border border-white/15 p-20 md:p-32 xl:p-40 xl:pr-56"
					>
						<div class="flex flex-col items-start gap-32 md:gap-40 lg:flex-row">
							<div class="space-y-16 md:space-y-24 lg:sticky lg:top-0 lg:w-5/12 xl:w-4/12">
								{% if item.title %}
									<h3 class="h4 first-letter:text-accent xl:max-w-390">{{ item.title }}</h3>
								{% endif %}
								{% if item.excerpt %}
									<p class="fp-text-body-small text-white/80 xl:max-w-320">
										{{ item.excerpt }}
									</p>
								{% endif %}
							</div>
							{% if item.text %}
								<div class="fp-text-body-small fp-richtext text-white/90 lg:w-7/12 xl:ml-auto xl:w-7/12">
									{{ item.text|raw }}
								</div>
							{% endif %}
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</section>
{% endif %}
