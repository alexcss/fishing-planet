{#
# Career Jobs Grid Section
# React-powered filterable jobs grid with department/location filters and pagination
#}

<section id="job-openings" class="relative pb-30 md:pb-40 xl:pt-80">
	<div class="relative z-10 container">
		{% if data.title or data.tagline %}
			<div class="mb-32 flex flex-col gap-24 md:mb-56 md:flex-row md:items-center md:justify-between md:gap-32 xl:mb-60">
				{% if data.title %}
					<h2 class="h2">{{ data.title }}</h2>
				{% endif %}
				{% if data.tagline %}
					<div class="fp-block-corners w-full text-white md:max-w-300 lg:ml-auto">
						<p class="h5 text-center">
							{{ jobs_total }} {{ data.tagline }}
						</p>
					</div>
				{% endif %}
			</div>
		{% endif %}

		<div id="career-jobs-root">
			<div class="flex justify-center py-80">
				<div class="border-accent h-48 w-48 animate-spin rounded-full border-4 border-t-transparent"></div>
			</div>
		</div>
	</div>
</section>

<script>
	window.careerJobsData = { filterData: {{ jobs_filter_data|json_encode|raw }}, initialJobs: {{ jobs_initial_jobs|json_encode|raw }}, initialTotal: {{
		jobs_total
	}}, initialPage: 1, perPage: {{ jobs_per_page }}, apiEndpoint: '{{ fn("rest_url", "fp/v1/careers") }}' };
</script>
