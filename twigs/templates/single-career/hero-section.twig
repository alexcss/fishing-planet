{#
 # Single Career - Hero Section
 # Title, excerpt, department, location, apply button
 #}

{% from "components/buttons.twig" import button %}
{% from "components/icon.twig" import icon %}

<section class="relative pt-40 pb-40 md:pt-60 md:pb-60">
	<div class="relative z-10 container">
		<div class="relative">
			{% include "components/back-button.twig" with { class: "mb-40 lg:absolute lg:left-0 lg:top-6" } %}

			<div class="lg:mx-auto lg:max-w-640 xl:max-w-756">
				<h1 class="h2 mb-20 md:mb-26">{{ post.title }}</h1>

				{% if post.post_excerpt %}
					<p class="fp-text-body-article mb-24 text-white/80 md:mb-32">
						{{ post.post_excerpt }}
					</p>
				{% endif %}

				<div class="mb-32 flex flex-wrap items-center gap-24 md:mb-40 md:gap-32">
					{% if departments %}
						<div class="flex items-center gap-12">
							<span class="fp-btn-corners bg-black-true/10 flex-none"><span>{{ icon({ name: "case", w: 18, h: 18 }) }}</span></span>
							<span class="fp-heading-text text-24/none">{{ departments|join(", ") }}</span>
						</div>
					{% endif %}
					{% if locations %}
						<div class="flex items-center gap-12">
							<span class="fp-btn-corners bg-black-true/10 flex-none"><span>{{ icon({ name: "location", w: 18, h: 18 }) }}</span></span>
							<span class="fp-heading-text text-24/none">{{ locations|join(", ") }}</span>
						</div>
					{% endif %}
				</div>

				{{ button({ link: { url: "#apply-form", title: __("Apply", "fp") } }) }}
			</div>
		</div>
	</div>
	<div class="bg-pattern-wave pointer-events-none absolute inset-x-0 top-0 z-0 h-730 mask-y-from-80% mask-y-to-100% lg:h-510"></div>
</section>
