{#
# Single Career - Apply Form Section
# Contact Form 7 apply form from the Career page ACF
#}

{% if apply_form.form %}
	<section id="apply-form" class="xl-pb-100 relative pt-32 pb-54 md:py-60 xl:pt-40">
		<div class="relative z-10 container">
			<div class="bg-gray-gunmetal p-20 pt-40 md:p-40 md:pt-60 xl:p-40 xl:pt-80">
				{% if apply_form.form_title %}
					<h2 class="h2 mb-32 md:mb-40 lg:text-center xl:mb-54">{{ apply_form.form_title }}</h2>
				{% endif %}
				<div class="mx-auto max-w-1100">
					{{ fn("do_shortcode", apply_form.form) }}
				</div>
			</div>
		</div>
		<div class="bg-pattern-wave pointer-events-none absolute inset-0 mask-y-from-60% mask-y-to-100% opacity-60"></div>
	</section>
{% endif %}
