{% extends "base.twig" %}

{% block content %}
	<main>
		<div class="container">
			<article>
				<h1>{{ post.title }}</h1>
				<div>
					{{ post.content }}
				</div>
			</article>
		</div>

		{% include 'templates/front-page/cta-section.twig' with {cta: post.meta('cta'), global: global} %}
	</main>
{% endblock %}
