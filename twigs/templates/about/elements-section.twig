{#
# Elements Section
# Section displaying element cards with title, image, and text
#}

{% if data and data.cards is not empty %}
	<section class="peer group py-80 xl:py-120 peer-[.group]:xl:pt-60">
		<div class="container">
			<div class="mb-32 flex flex-col gap-24 md:mb-60 lg:flex-row lg:items-start lg:gap-80">
				{% if data.title %}
					<h2 class="h2">{{ data.title }}</h2>
				{% endif %}

				{% if data.tagline %}
					<div class="fp-block-corners w-full text-white md:hidden lg:ml-auto lg:block lg:max-w-375 lg:px-40">
						<p class="h5 text-center">
							{{ data.tagline }}
						</p>
					</div>
				{% endif %}
			</div>
		</div>
		{% set is_two_cols = (data.cards|length) <= 2 %}

		<div class="lg:border-t lg:border-b lg:border-white/15">
			<div class="container">
				<div
					class="grid grid-cols-1 gap-40 md:grid-cols-3 md:gap-x-20 lg:gap-y-0 {{
					is_two_cols
						? "lg:gap-x-40 lg:grid-cols-2 xl:gap-x-80"
						: "lg:gap-x-40"
					}}"
				>
					{% for card in data.cards %}
						<div class="relative md:col-span-2 lg:col-span-1 lg:py-30">
							{% include "components/card-simple.twig" with { card: card, image_type: is_two_cols ? "wide" } %}
							{% if not loop.first %}
								<div class="absolute inset-y-0 -left-20 z-0 w-1 bg-white/15 max-lg:hidden {{ is_two_cols ? "xl:-left-40" }}"></div>
							{% endif %}
						</div>
						{% if loop.first %}
							{% if data.tagline %}
								<div class="relative -mt-16 max-md:hidden md:row-span-3 md:mt-0 lg:hidden">
									<div class="fp-block-corners text-white md:sticky md:top-120 lg:max-w-315">
										<p class="h5 text-center">
											{{ data.tagline }}
										</p>
									</div>
								</div>
							{% endif %}
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</div>
	</section>
{% endif %}
