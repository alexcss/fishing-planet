{#
# Fish Section
# Section with subtitle, title, tagline, auto-scrolling fish gallery (marquee), and content blocks
#}

{% from "components/image.twig" import image %}

{% if data %}
	{% set bg_image_desktop = data.bg_image_desktop.url %}
	{% set bg_image_mobile = data.bg_image_mobile.url ?: data.bg_image_desktop.url %}

	<section
		class="bg-gray-tar fp-section-image-bg relative overflow-hidden"
		{% if bg_image_desktop %}
			style="--section-image-bg-mobile: url({{ bg_image_mobile|resize(768, 1024, "center")|towebp(80)  }}); --section-image-bg-desktop: url({{ bg_image_desktop|resize(2560, 1440, "center")|towebp(80) }});"
		{% endif %}
	>
		<div class="relative z-20 container pt-60 pb-32 md:py-60 xl:py-100">
			{# Header: Subtitle, Title, Tagline #}
			<div class="mb-24 md:mb-60 xl:mb-100 flex flex-col gap-24 lg:flex-row lg:items-start">
				{% if data.subtitle %}
					<p class="fp-text-small-description text-sand lg:order-1 lg:max-w-160 lg:pt-2 xl:pt-4">
						{{ data.subtitle }}
					</p>
				{% endif %}

				{% if data.title %}
					<h2 class="h2">{{ data.title }}</h2>
				{% endif %}

				{% if data.tagline %}
					<div class="fp-block-corners w-full text-white lg:order-last lg:ml-auto lg:w-fit lg:max-w-360 lg:px-60">
						<p class="h5 text-center">
							{{ data.tagline|steam_icon  }}
						</p>
					</div>
				{% endif %}
			</div>

			{# Auto-scrolling Fish Gallery (Marquee) #}
			{% if data.gallery is not empty %}
				<div class="mb-40 md:mb-60 xl:mask-x-from-94% xl:mask-x-to-100%"
				     x-data="videoSlider({
				       	slidesPerView: 'auto',
						spaceBetween: 20,
						loop: true,
						speed: 6000,
						allowTouchMove: false,
						autoplay: {
						  delay: 1,
						  disableOnInteraction: false
						}
				      })"
				>
					<div class="swiper max-xl:overflow-visible" x-ref="swiperContainer">
						<div class="swiper-wrapper ease-linear">
							{% for fish_image in data.gallery %}
								<div class="swiper-slide w-472">
									{{ image({ image: fish_image, class: "w-472 h-182 object-contain", sizes: { w: 472 } }) }}
								</div>
							{% endfor %}
							{% for fish_image in data.gallery %}
								<div class="swiper-slide w-472">
									{{ image({ image: fish_image, class: "w-472 h-182 object-contain", sizes: { w: 472 } }) }}
								</div>
							{% endfor %}
						</div>
					</div>
				</div>
			{% endif %}

			{# Content Blocks #}
			{% if data.content is not empty %}
				<div class=""
				     x-data="videoSlider({
				       	slidesPerView: 1,
						spaceBetween: 18,
						loop: false,
						breakpoints: {
							1024: {
								allowTouchMove: false,
								enabled: false,
								spaceBetween: 0,
							}
						}
				      })"
				>
				  <div class="swiper max-lg:overflow-visible" x-ref="swiperContainer">
					  <div class="swiper-wrapper lg:grid lg:gap-20 xl:gap-40 lg:grid-cols-2">
						{% for item in data.content %}
							<div class="swiper-slide lg:w-auto! h-auto lg:h-full">
							  <div class="h-full fp-block-corners border border-white/15 bg-white/10 px-20 py-24 md:px-40 md:py-36">
								  <div class="flex flex-col gap-20 md:flex-row md:items-center md:gap-40 h-full">
									  {% if item.title %}
										  <h3 class="h4 shrink-0 md:w-160">{{ item.title }}</h3>
									  {% endif %}

									  {% if item.text %}
										  <div class="fp-text-body-small fp-richtext text-white/80">
											  {{ item.text|raw }}
										  </div>
									  {% endif %}
								  </div>
							  </div>
							</div>
						{% endfor %}
					  </div>
				  </div>

				  {% include "global/slider/controls.twig" with { class: "mt-32 lg:hidden", slides: data.content, variant: "light" } %}
				</div>

			{% endif %}
		</div>
	</section>

{% endif %}
